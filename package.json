{
  "name": "@proangular/pro-form",
  "version": "22.0.0",
  "description": "A predefined set of reactive and reusable form input components based on Angular Material.",
  "author": "Pro Angular <webmaster@proangular.com>",
  "homepage": "https://www.proangular.com",
  "private": false,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "lint": "ng lint",
    "ng": "ng",
    "npm-build-package": "ng-packagr -p ng-package.json",
    "postinstall": "is-ci || husky",
    "prettier": "prettier --write . --log-level silent",
    "prettier:check": "prettier --check .",
    "start": "ng serve --open",
    "test": "ng test",
    "update": "ncu -u",
    "update:check": "ncu",
    "watch": "ng build --watch --configuration development",
    "test:coverage": "ng test --watch=false --coverage"
  },
  "peerDependencies": {
    "@angular/cdk": ">=22 <23",
    "@angular/common": ">=22 <23",
    "@angular/core": ">=22 <23",
    "@angular/forms": ">=22 <23",
    "@angular/material": ">=22 <23",
    "@angular/material-luxon-adapter": ">=22 <23",
    "luxon": ">=3 <4",
    "rxjs": ">=7.8 <8"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cdk": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.7",
    "@angular/material-luxon-adapter": "^22.2.7",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/luxon": "^3.4.2",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.1.1",
    "angular-eslint": "^22.7.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jsdom": "^30.0.0",
    "luxon": "^3.4.4",
    "ng-packagr": "^22.2.6",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.10.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.0"
  },
  "contributors": [
    {
      "name": "Cody Tolene",
      "email": "webmaster@codytolene.com",
      "url": "https://www.codytolene.com"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProAngular/pro-form.git"
  },
  "keywords": [
    "pro",
    "angular",
    "material",
    "form",
    "forms",
    "input",
    "inputs",
    "custom",
    "pro-form",
    "ngx"
  ],
  "bugs": {
    "url": "https://github.com/ProAngular/pro-form/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/proangular"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "src/main.ts",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.9": true,
    "msgpackr-extract@3.0.7": true
  }
}
